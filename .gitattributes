# 统一换行符规则，避免跨平台协作时产生整文件 diff
# 默认：仓库内统一存 LF，检出时由 core.autocrlf 决定本地形态
* text=auto eol=lf

# 明确指定为文本的类型
*.py    text eol=lf
*.pyi   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.md    text eol=lf
*.mdc   text eol=lf
*.txt   text eol=lf
*.in    text eol=lf
*.sh    text eol=lf
*.example text eol=lf
.gitignore     text eol=lf
.dockerignore  text eol=lf
.editorconfig  text eol=lf
.pylintrc      text eol=lf
Dockerfile     text eol=lf

# Windows 专用脚本必须保留 CRLF，否则无法执行
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做任何换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.whl   binary
*.db    binary
*.pyc   binary
