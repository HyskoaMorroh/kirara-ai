# Docker Hub image produced by the GitHub Actions workflow.
# Do not include Docker Hub tokens, API keys, or bot tokens in this file.
DOCKERHUB_IMAGE=your-dockerhub-username/kirara-agent-framework:latest

# ---------------------------------------------------------------------------
# LLOneBot (QQ) — only needed when you run the two-container topology from
# docker-compose.yml.example / docs/QQ_ONEBOT_OPERATIONS.md.
#
# Both variables are referenced with the `:?` form, which makes Compose fail
# fast when they are unset. That is deliberate: an empty AUTH_TOKEN would
# publish an unauthenticated OneBot endpoint, and a wrong QQ number silently
# logs in the wrong account.
#
# Fill these in on the server only. This file is the committed template; the
# real `.env` is excluded from Git (.gitignore) and from the Docker build
# context (.dockerignore).
# ---------------------------------------------------------------------------

# Shared secret between LLOneBot and Kirara's reverse-WebSocket endpoint.
# Generate one per instance, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`.
LLONEBOT1_AUTH_TOKEN=

# QQ number used for quick login (digits only, no quotes).
LLONEBOT1_QQ=

# Second QQ instance. Leave both blank unless you enable the `llonebot2`
# service; Compose only evaluates `:?` for services it actually starts.
LLONEBOT2_AUTH_TOKEN=
LLONEBOT2_QQ=
