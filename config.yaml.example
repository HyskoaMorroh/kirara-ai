# 配置文件示例
# 通讯平台配置部分
ims:
  # 每个 IM 平台的具体配置
  - name: "telegram-bot-1234"  # IM 平台实例名称
    enable: true              # 是否启用该平台
    adapter: "telegram"       # 使用的适配器类型
    config:                   # 平台特定的配置
      token: "abcd"          # 平台的 API 令牌

# 插件系统配置
plugins:
  enable: []                 # 启用的插件列表

# Web 服务器配置
web:
  host: "127.0.0.1"         # Web 服务器监听地址
  port: 8080                # Web 服务器端口
  secret_key: "please-change-this-to-a-secure-secret-key"  # Web 服务器安全密钥，请修改为安全的值
  password_file: "web/password.hash"  # 相对路径存储在 DATA_PATH 内

# LLM (大语言模型) 配置
llms:
  api_backends:             # API 后端配置列表
    # DeepSeek API 配置
    - name: "deepseek-official"  # 后端名称
      adapter: "deepseek"        # 使用的适配器
      enable: true               # 是否启用
      config:                    # API 具体配置
        api_key: "your-api-key"  # API 密钥
        api_base: "https://api.deepseek.com/v1"  # API 基础 URL
      models:                    # 支持的模型列表
        - "deepseek-chat"
        - "deepseek-coder"
    
    # OpenAI API 配置
    - name: "openai-gpt4"        # 后端名称
      adapter: "openai"          # 使用的适配器
      enable: true               # 是否启用
      config:                    # API 具体配置
        api_key: "your-openai-key"  # OpenAI API 密钥
        api_base: "https://api.openai.com/v1"  # OpenAI API 基础 URL
      models:                    # 支持的模型列表
        - "gpt-4"
        - "gpt-4-turbo"
      # 推理强度：low / medium / high / max，留空（或整行删除）表示不指定，
      # 沿用上游默认。各家字段不同，由适配器翻译：OpenAI 系为 reasoning_effort，
      # Claude 为 thinking 预算，Gemini 为 thinkingConfig。
      # 注意：不支持扩展思考的模型收到该字段会报错，所以「不指定」是默认行为。
      # reasoning_effort: max
      # 移除该供应商回复里的 AI 自我署名（如「作为一个 AI 助手」「本回复由 AI 生成」）。
      # 默认 false：这是会改写模型输出的开关。只删署名句，不动答案、代码块、
      # 工具参数与用量统计；细节见 docs/EXTENDING.md 第 9.2 节。
      # hide_ai_attribution: false
      # 故障转移队列优先级，数字越小越优先；完整的重试/超时/熔断参数见
      # docs/OBSERVABILITY.md 与 WebUI 的「自动故障转移」卡片。
      # priority: 100

# 版本更新检查
update:
  # 禁用启动时的自动版本检查。离线或内网部署既查不到 PyPI 又要等超时；
  # 打开后完全不发起请求，WebUI 的「检查更新」按钮仍然可用。
  disable_auto_check: false

# 默认配置
defaults:
  llm_model: gemini-1.5-flash  # 默认使用的 LLM 模型

# 记忆系统配置
memory:
  persistence:                  # 持久化配置
    type: file                 # 持久化类型（支持 file 或 redis）
    file:                      # 文件存储配置
      storage_dir: ./data/memory  # 存储目录
    redis:                     # Redis 存储配置
      host: localhost          # Redis 主机地址
      port: 6379              # Redis 端口
      db: 0                   # Redis 数据库编号
  max_entries: 100            # 最大记忆条目数
  default_scope: member       # 默认记忆作用域

# 统一 Agent 运行时配置
agent_runtime:
  context_char_threshold: 0  # 上下文压缩阈值，0 表示保持默认行为
  debug_hooks_enabled: true  # 注册受控的 Agent 调试 Hook Handler
  # 声明哪些 IM 渠道身份属于项目创建者。
  #
  # 默认为空。不声明时聊天侧拿不到任何身份，因此 MCP 工具与 command 型 Hook
  # 在 IM 渠道上一律不可用（这是升级前的行为）。声明之后，来自这些身份的消息
  # 会带上创建者 principal，从而能像在 WebUI 里一样使用受保护的插件能力。
  #
  # 三点务必看清：
  #   1. 渠道与发送者一起比。QQ 号和 Telegram 用户 ID 可能撞号。
  #   2. 群聊默认不生效。群里所有人都看得到你发的指令并照抄；照抄的人拿不到
  #      身份，但把宿主操作暴露在多人可见的会话里是另一回事。
  #      要开必须显式写 allow_group_chat: true。
  #   3. 这里填的是**你自己**在该渠道上的用户标识，不是机器人的。
  creator_channel_identities: []
  # creator_channel_identities:
  #   - channel_type: onebot        # webui / onebot / qqbot / telegram / wecom
  #     sender_scope: "10001"       # 你自己的 QQ 号
  #     # account_scope: "20002"    # 可选：只认经由这个机器人账号收到的消息
  #     # adapter_instance: onebot-main  # 可选：限定适配器实例
  #     # allow_group_chat: false   # 群聊里是否生效，默认关闭
