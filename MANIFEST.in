recursive-include kirara_ai/plugins/im_http_legacy_adapter/assets *
recursive-include kirara_ai/plugins/im_qqbot_adapter/assets *
recursive-include kirara_ai/plugins/im_telegram_adapter/assets *
recursive-include kirara_ai/plugins/im_wecom_adapter/assets *
recursive-include kirara_ai/plugins/im_onebot_adapter/assets *
recursive-include kirara_ai/alembic *
recursive-include kirara_ai/web/static *
# 开箱可用的预设工作流。这些 YAML 由 WorkflowRegistry.load_workflows() 在首次
# 启动时复制到 data/workflows，若不随 wheel 分发，pip 安装的用户只能拿到代码
# 预设，多模态 / 分段回复 / 深度思考等增强工作流全部缺失。
recursive-include kirara_ai/workflow/presets *

# 随包技能：`_BUILTINS` 里 31 条 `bundled_dir` 条目的正文。缺它们时
# `ensure_builtins()` 会对每一条报「随包技能目录缺失」——而那正是「测试全绿
# 但 pip 装完少东西」的形状（本项目在 yarn.lock 上踩过同一种：本机有、
# 干净环境没有）。
recursive-include kirara_ai/plugin_manager/bundled *

recursive-exclude kirara_ai __pycache__
recursive-exclude kirara_ai *.py[cod]
